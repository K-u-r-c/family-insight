{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true
  },
  "include": ["docs/.vitepress/**/*.ts", "docs/.vitepress/**/*.mts", "docs/**/*.paths.mts"],
  "exclude": ["docs/.vitepress/cache", "docs/.vitepress/dist"]
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.screenshots.config.ts",
    "playwright.perf.config.ts",
    "e2e/**/*",
    "docs/.screenshots/**/*",
    "docs/.test/**/*",
    "playwright.docs.config.ts",
    "src/core/**/*",
    "src/shared/pseudo.ts",
    "src/shared/i18n.ts"
  ],
  "exclude": ["src/core/**/*.test.ts"]
}
